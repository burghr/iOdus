+/* After a complete network sign-in: keep the identity only when the backend
+ * says that Microsoft issued an offline lease to this device at this start.
+ * Remove it when offline play is not (or no longer) granted. */
+static void remember_offline_identity( struct XUser *user, const BYTE *defaults, SIZE_T defaultsSize,
+                                       const BYTE *current, SIZE_T currentSize )
+{
+    enum offline_identity_mode mode = offline_identity_mode();
+    struct offline_identity identity = {0};
+
+    if (mode == OFFLINE_IDENTITY_USE) return;
+    if (mode == OFFLINE_IDENTITY_NONE)
+    {
+        offline_store_remove();
+        return;
+    }
+    identity.xuid = user->xuid;
+    identity.age_group = user->age_group;
+    identity.saved_at = offline_file_time_now();
+    lstrcpynA( identity.gamertag, user->gamertag, sizeof(identity.gamertag) );
+    lstrcpynA( identity.modern_gamertag, user->modernGamertag, sizeof(identity.modern_gamertag) );
+    lstrcpynA( identity.modern_gamertag_suffix, user->modernGamertagSuffix, sizeof(identity.modern_gamertag_suffix) );
+    lstrcpynA( identity.unique_modern_gamertag, user->uniqueModernGamertag, sizeof(identity.unique_modern_gamertag) );
+    if (!offline_store_save( &identity, defaults, defaultsSize, current, currentSize )) WARN( "offline identity not stored.\n" );
+}
+
+/* Microsoft is not reachable, and the backend started the game on a valid
+ * offline license: complete the sign-in from the stored identity. Each other
+ * failure stays. */
+static HRESULT sign_in_offline( struct XUser *user, HRESULT failure )
+{
+    struct offline_identity identity;
+    char *defaults = NULL, *current = NULL;
+    SIZE_T defaultsSize, currentSize;
+    HRESULT hr = failure;
+
+    if (!offline_connectivity_failure( failure ) || offline_identity_mode() != OFFLINE_IDENTITY_USE) return failure;
+    if (!offline_store_load( offline_file_time_now(), &identity, &defaults, &defaultsSize, &current, &currentSize )) return failure;
+    if (SUCCEEDED(load_endpoints( user, (BYTE *)defaults, defaultsSize )) &&
+        SUCCEEDED(load_endpoints( user, (BYTE *)current, currentSize )))
+    {
+        user->xuid = identity.xuid;
+        user->age_group = identity.age_group;
+        lstrcpynA( user->gamertag, identity.gamertag, sizeof(user->gamertag) );
+        lstrcpynA( user->modernGamertag, identity.modern_gamertag, sizeof(user->modernGamertag) );
+        lstrcpynA( user->modernGamertagSuffix, identity.modern_gamertag_suffix, sizeof(user->modernGamertagSuffix) );
+        lstrcpynA( user->uniqueModernGamertag, identity.unique_modern_gamertag, sizeof(user->uniqueModernGamertag) );
+        user->offline = TRUE;
+        InterlockedExchange( &xuser_offline_identity_in_use, 1 );
+        WARN( "Microsoft is unreachable (hr %#lx); continuing with the stored offline identity.\n", failure );
+        hr = S_OK;
+    }
+    free( defaults );
+    free( current );
+    return hr;
+}
