#!/bin/sh
# Starts Wine for a game: xodus-cli runs this script as "wine <executable> <arguments>".
# IODUS_REAL_WINE is the Wine program of the runtime.
#
# PlayFab saves: when IODUS_PLAYFAB_PROXY names the proxy PlayFabGameSave.dll
# (from Xodus Nexus, scripts/runtime-compat/nexus-playfab-*.c), the game's
# PlayFabGameSave.dll in the backend's temporary launch folder is put behind it:
# the game's DLL stays available as nexus_pgs_native.dll, and the proxy takes its
# name. The launch folder holds links to the game files; only the link changes,
# never an installed game file. Without it, Forza Horizon 6 stops with E:0-17-4.
set -u
REAL=${IODUS_REAL_WINE:?IODUS_REAL_WINE is not set}
# macOS removes DYLD_* variables when it starts /bin/sh. Wine needs them: the
# library path for GnuTLS and FreeType, and on the native arm64 runtimes also the
# framework path for GStreamer (videos through Media Foundation). iOdus passes
# a copy of each as IODUS_DYLD_*.
if [ -n "${IODUS_DYLD_FALLBACK_LIBRARY_PATH:-}" ]; then
  DYLD_FALLBACK_LIBRARY_PATH=$IODUS_DYLD_FALLBACK_LIBRARY_PATH
  export DYLD_FALLBACK_LIBRARY_PATH
fi
if [ -n "${IODUS_DYLD_FALLBACK_FRAMEWORK_PATH:-}" ]; then
  DYLD_FALLBACK_FRAMEWORK_PATH=$IODUS_DYLD_FALLBACK_FRAMEWORK_PATH
  export DYLD_FALLBACK_FRAMEWORK_PATH
fi
EXE=${1:-}
STAGED=0

if [ -n "${IODUS_PLAYFAB_PROXY:-}" ] && [ -f "$IODUS_PLAYFAB_PROXY" ] && [ -n "$EXE" ]; then
  VIEW=$(dirname "$EXE")
  case $(basename "$VIEW") in
    .xodus-chain-*|.xodus-offline-*)
      for SDK in "$VIEW"/*; do
        case $(basename "$SDK" | tr '[:upper:]' '[:lower:]') in playfabgamesave.dll) ;; *) continue ;; esac
        # Only a link from the backend; a real file is left as it is.
        [ -L "$SDK" ] || continue
        TARGET=$(readlink "$SDK")
        rm -f "$VIEW/nexus_pgs_native.dll"
        ln -s "$TARGET" "$VIEW/nexus_pgs_native.dll" || exit 70
        rm "$SDK" && cp "$IODUS_PLAYFAB_PROXY" "$SDK" || { echo "iOdus: PlayFab staging failed" >&2; exit 70; }
        STAGED=1
      done
      ;;
  esac
fi

if [ "$STAGED" = 1 ]; then
  WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}playfabgamesave=n;nexus_pgs_native=n"
  export WINEDLLOVERRIDES
  echo "iOdus: PlayFab save proxy staged" >&2
fi
exec "$REAL" "$@"
